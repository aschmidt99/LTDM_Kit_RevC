	(gr_text "Checks before expecting good feedback:\n- Has S+H offset been calibrated?\n\n- Are all jumpers in standard positions?\n	-Ch1:\n		J1: Pre resistor\n		J27: Closed (allows send to jack)\n		J29: Sample and Hold Bypass: Pins 1+2\n		J17: DSP insert Pins 2+3 shorted\n		\n	-Ch2"
		(at -6.096 42.418 0)
		(layer "Dwgs.User")
